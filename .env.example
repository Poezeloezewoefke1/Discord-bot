# Copy this file to .env and fill it in. Never commit .env.

# Bot token from https://discord.com/developers/applications -> your app -> Bot -> Reset Token
DISCORD_TOKEN=your-token-here

# Your server's ID. Right-click the server -> Copy Server ID (needs Developer Mode on).
# Optional, but strongly recommended: with it, slash commands appear instantly.
# Without it they sync globally and can take up to an hour to show up.
GUILD_ID=

# Optional overrides — the defaults are fine.
# DB_PATH=buildboard.db
# SCHEMATIC_DIR=schematics
